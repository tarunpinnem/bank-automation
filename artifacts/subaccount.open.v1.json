{
  "schema_version": 1,
  "capability_id": "subaccount.open",
  "version": 1,
  "target": {
    "app": "meridian-teller-console",
    "base_url": "http://127.0.0.1:8000",
    "app_version_fingerprint": "sha256:8aba87b44764c003"
  },
  "inputs": {
    "member_id": {
      "type": "string",
      "required": true,
      "example": "12345",
      "sensitive": true
    },
    "account_type": {
      "type": "string",
      "required": true,
      "example": "vacation",
      "sensitive": false
    },
    "opening_deposit": {
      "type": "number",
      "required": true,
      "example": "100",
      "sensitive": false
    }
  },
  "outputs": {
    "account_number": {
      "type": "string"
    }
  },
  "steps": [
    {
      "id": "s0",
      "action": "type",
      "target": {
        "primary": {
          "strategy": "role",
          "role": "textbox",
          "name": "Member ID"
        },
        "fallbacks": [
          {
            "strategy": "text_near",
            "label": "Member ID"
          },
          {
            "strategy": "css",
            "selector": "input[name=\"member_id\"]"
          }
        ]
      },
      "value": "{{member_id}}",
      "condition": null,
      "output": null,
      "extract_label": null,
      "risk_level": "safe"
    },
    {
      "id": "s1",
      "action": "click",
      "target": {
        "primary": {
          "strategy": "role",
          "role": "button",
          "name": "Search"
        },
        "fallbacks": [
          {
            "strategy": "text_near",
            "label": "Search"
          }
        ]
      },
      "value": null,
      "condition": null,
      "output": null,
      "extract_label": null,
      "risk_level": "safe"
    },
    {
      "id": "s2",
      "action": "click",
      "target": {
        "primary": {
          "strategy": "role",
          "role": "button",
          "name": "Open Sub-Account"
        },
        "fallbacks": [
          {
            "strategy": "text_near",
            "label": "Open Sub-Account"
          }
        ]
      },
      "value": null,
      "condition": null,
      "output": null,
      "extract_label": null,
      "risk_level": "safe"
    },
    {
      "id": "s3",
      "action": "select",
      "target": {
        "primary": {
          "strategy": "role",
          "role": "combobox",
          "name": "Sub-Account Type"
        },
        "fallbacks": [
          {
            "strategy": "text_near",
            "label": "Sub-Account Type"
          },
          {
            "strategy": "css",
            "selector": "select[name=\"account_type\"]"
          }
        ]
      },
      "value": "Vacation Fund",
      "condition": null,
      "output": null,
      "extract_label": null,
      "risk_level": "safe"
    },
    {
      "id": "s4",
      "action": "type",
      "target": {
        "primary": {
          "strategy": "role",
          "role": "textbox",
          "name": "Opening Deposit ($)"
        },
        "fallbacks": [
          {
            "strategy": "text_near",
            "label": "Opening Deposit ($)"
          },
          {
            "strategy": "css",
            "selector": "input[name=\"opening_deposit\"]"
          }
        ]
      },
      "value": "{{opening_deposit}}",
      "condition": null,
      "output": null,
      "extract_label": null,
      "risk_level": "safe"
    },
    {
      "id": "s5",
      "action": "click",
      "target": {
        "primary": {
          "strategy": "role",
          "role": "button",
          "name": "Continue"
        },
        "fallbacks": [
          {
            "strategy": "text_near",
            "label": "Continue"
          }
        ]
      },
      "value": null,
      "condition": null,
      "output": null,
      "extract_label": null,
      "risk_level": "risky"
    },
    {
      "id": "s6",
      "action": "extract",
      "target": null,
      "value": null,
      "condition": null,
      "output": "account_number",
      "extract_label": "New Account Number",
      "risk_level": "safe"
    }
  ],
  "checkpoint": {
    "success": {
      "role": "heading",
      "name_contains": "Confirmation"
    }
  },
  "business_outcomes": [
    {
      "when": {
        "text_contains": "Validation error"
      },
      "result": {
        "account_number": null
      },
      "name": "validation_error_deposit_too_low"
    }
  ],
  "risk_level": "safe",
  "tenant_overrides": {}
}